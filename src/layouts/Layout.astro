---
import { withBase } from '../utils/paths';
const {title='Lab. of Theriogenology',description='충남대학교 수의산과학 실험실. 번식 생리, 배아 발달과 재생의학을 연구합니다.'}=Astro.props;
const nav=[['/research/','Research'],['/people/','People'],['/publications/','Publications'],['/contact/','Contact']];
import '../styles.css';
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#172e48"/><title>{title} · CNU</title><link rel="icon" href={withBase('/images/cnu.svg')} type="image/svg+xml"/></head><body><a class="skip" href="#main">본문으로 이동</a><header><a class="brand" href={withBase('/')}><span class="brand-mark">T<span>°</span></span><span>THERIOGENOLOGY<small>CHUNGNAM NATIONAL UNIVERSITY</small></span></a><button class="menu" aria-expanded="false" aria-controls="navigation">메뉴 ☰</button><nav id="navigation">{nav.map(([url,label])=><a href={withBase(url)} aria-current={Astro.url.pathname===withBase(url)?'page':undefined}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><div><a class="footer-title" href={withBase('/')}>Lab. of Theriogenology<span>충남대학교 수의산과학 실험실</span></a><p>번식 생리 · 배아 발달 · 재생의학</p></div><div><p>College of Veterinary Medicine<br/>Chungnam National University</p><a href="mailto:ybjeon@cnu.ac.kr">ybjeon@cnu.ac.kr ↗</a></div><div class="footline"><span>© {new Date().getFullYear()} CNU Theriogenology Lab</span><span>Daejeon, Republic of Korea</span></div></footer><script>const b=document.querySelector('.menu');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));document.querySelector('nav')?.classList.toggle('open',open)});</script></body></html>
